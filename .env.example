# ============================================================
# TRUSTED / SERVER-ONLY & PLATFORM CONFIGURATION
# (Server-side runtime secrets & AI Studio platform variables)
# MUST NOT be prefixed with VITE_ or bundled into client JS.
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Used exclusively in server-side API routes / platform tooling.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ============================================================
# PUBLIC CLIENT CONFIGURATION (Vite Web SDK Parameters)
# Safe for exposure in browser bundles.
# ============================================================

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check / reCAPTCHA Configuration (Public Site Key)
VITE_RECAPTCHA_SITE_KEY=
VITE_ENABLE_MOCK_ADMIN=false

# Runtime App Environment ('development' | 'preview' | 'production')
# Controls Leadership Preview Banner, Search Engine Noindex Metadata, and Preview Submission Safeguards.
VITE_APP_ENV="preview"

# ============================================================
# TRUSTED / LOCAL DEVELOPMENT SECRETS (Uncommitted .env.local)
# Registered App Check debug tokens or local test flags.
# Strictly guarded by import.meta.env.DEV in source code.
# MUST NOT be committed to Git or shipped in production bundles.
# ============================================================

# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# (Set to 'true' in local .env.local to auto-generate a debug token in browser console,
# or set to a registered UUID debug token string for local CI/dev testing.)

